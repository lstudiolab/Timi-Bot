# Discord application credentials
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id

# Optional: register commands only in this server while developing.
# Leave blank to register commands globally.
GUILD_ID=

# Persistent settings, moderation cases, and recovery archives.
DATA_DIR=data

# Logging: debug, info, warn, error
LOG_LEVEL=info

# Optional Timi Pro checkout URL (requires an external payment provider/webhook).
TIMI_PRO_CHECKOUT_URL=
