DISCORD_TOKEN=put_your_bot_token_here
CLIENT_ID=put_your_application_id_here
GUILD_ID=put_your_test_server_id_here

# Public HTTPS URL of the Render Static Site that serves public/index.html (no trailing slash)
BASE_URL=https://your-timi-frontend.onrender.com

# Exact Render Static Site origin allowed to call the Termux backend API
FRONTEND_ORIGIN=https://your-timi-frontend.onrender.com
PORT=3000

# SMTP provider credentials used to send one-time email codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
VERIFICATION_FROM=Timi Verification <verify@example.com>

# Use a long random secret. Keep stable between restarts so IP blocks remain readable.
IP_HASH_SECRET=replace-with-a-long-random-secret
TRUST_PROXY=false
