# Required: Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=your_discord_bot_token

# Required: Discord application ID.
CLIENT_ID=your_discord_application_id

# Optional: set this to your test server ID for faster guild command updates.
# Leave blank to register commands globally.
GUILD_ID=

# Optional: directory used for settings, verification records and recovery data.
DATA_DIR=data

# Logging verbosity: error, warn, info, debug, trace
RUST_LOG=info
