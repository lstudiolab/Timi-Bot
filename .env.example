DISCORD_TOKEN=put_your_bot_token_here
CLIENT_ID=put_your_application_id_here
GUILD_ID=put_your_test_server_id_here

# Public HTTPS URL of this same Render web service (no trailing slash)
BASE_URL=https://your-timi-service.onrender.com
PORT=3000

# SMTP provider credentials used to send one-time email codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
VERIFICATION_FROM=Timi Verification <verify@example.com>

# Use a long random secret. Keep stable between deploys so IP blocks remain readable.
IP_HASH_SECRET=replace-with-a-long-random-secret
TRUST_PROXY=true
